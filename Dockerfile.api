FROM python:3.12-slim

RUN apt-get update && \
    apt-get install -y ffmpeg cron libchromaprint-tools curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY static/ ./static/
COPY shared_queue.py .
COPY docker-entrypoint-api.sh .
RUN chmod +x docker-entrypoint-api.sh

ENV LBDL_DATA_DIR=/app/music
ENV LBDL_CONFIG_DIR=/app/config
ENV LBDL_YTDLP_DIR=/app/config
ENV LBDL_AUDIO_FORMAT=opus
ENV LBDL_AUDIO_QUALITY=0
ENV LBDL_SCHEDULER_CRON="0 */2 * * *"
ENV LBDL_TZ=UTC

EXPOSE 8032

ENTRYPOINT ["./docker-entrypoint-api.sh"]
